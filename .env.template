# --- discovery ---
GH_TOKEN=                              # GitHub PAT (no scopes needed for public repos)

# --- OpenAI ---
OPENAI_API_KEY=                        # required for LLM + image generation
OPENAI_MODEL=gpt-5.4-mini
MAX_EVALUATIONS_PER_RUN=5

# --- scanner thresholds ---
VELOCITY_WINDOW_HOURS=72
REPO_MAX_AGE_DAYS=365
STAR_GROWTH_MIN_PCT=50
STAR_BASE_MIN=10
MAX_CANDIDATES_PER_RUN=15
DEVPOST_MAX_PROJECTS_PER_RUN=25

# --- database ---
DATABASE_URL=                          # Supabase transaction-pooler URL (port 6543)

# --- output paths ---
OUTPUT_DIR=output                      # rendered post images saved here for review

# --- scheduling ---
SCHEDULE_HOUR=6                        # local hour to fire pipeline daily
SCHEDULE_JITTER_MINUTES=15             # ±15 min jitter
TIMEZONE=UTC                           # IANA TZ name (e.g. America/New_York)

# --- publishing: LinkedIn API (optional) ---
# All four required for `python -m src publish <post_id>` to actually post.
# Without these the publishing service still runs in manual-export mode.
LINKEDIN_CLIENT_ID=                    # from LinkedIn Developer Portal → Auth tab
LINKEDIN_CLIENT_SECRET=                # from LinkedIn Developer Portal → Auth tab
LINKEDIN_ACCESS_TOKEN=                 # from Tools → OAuth Token Generator
LINKEDIN_ACTOR_URN=                    # urn:li:person:<sub> for personal, urn:li:organization:<id> for company page
LINKEDIN_API_VERSION=202604            # YYYYMM LinkedIn-Version header pin (LinkedIn supports each version ~12 months; the Posts API can lag the LMS docs by a release, and skips some months)

# --- publishing: Instagram Graph API (optional) ---
# Required if you want `python -m src publish <post_id>` to post Instagram
# packages. The IG account MUST be Business or Creator and linked to a
# Facebook Page (personal accounts cannot use the publishing API). Image
# hosting (next section) is also required — Instagram needs a public HTTPS
# URL for the image; it does not accept binary uploads.
IG_ACCESS_TOKEN=                       # long-lived Page access token, scopes: instagram_basic + instagram_content_publish + pages_show_list + pages_read_engagement + business_management (60-day expiry)
IG_BUSINESS_ACCOUNT_ID=                # from GET /<page-id>?fields=instagram_business_account
IG_APP_ID=                             # Meta app id (for future token refresh)
IG_APP_SECRET=                         # Meta app secret (for future token refresh)
IG_API_VERSION=v21.0                   # Facebook Graph API version

# --- publishing: S3-compatible image host (required for IG only) ---
# Works with Cloudflare R2 (cheap/easy — free tier covers indie use),
# AWS S3, Backblaze B2, or any S3-compatible service.
IMAGE_HOST_ENDPOINT=                   # e.g. https://<acct-id>.r2.cloudflarestorage.com — leave blank for AWS S3
IMAGE_HOST_BUCKET=                     # e.g. reporadar-cards
IMAGE_HOST_REGION=auto                 # 'auto' for R2; 'us-east-1' etc. for AWS
IMAGE_HOST_PUBLIC_BASE_URL=            # HTTPS URL prefix where uploaded objects are served — e.g. https://pub-<id>.r2.dev or https://cards.example.com (must be HTTPS, reachable from Facebook's servers)
IMAGE_HOST_ACCESS_KEY=
IMAGE_HOST_SECRET_KEY=
